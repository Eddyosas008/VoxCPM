# Copier ce fichier en conf/mindscript.local.env (ignoré par git) et remplir.
# Session : les identifiants du site mindscriptaudio.com — tout, dépôt du MP3 compris.
MINDSCRIPT_EMAIL=
MINDSCRIPT_PASSWORD=
